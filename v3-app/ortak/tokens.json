    "base": "#211E16",
    "scrimPercent": 55,
    "floatingIconPercent": 56,
    "curve": "smootherstep 6t^5-15t^4+10t^3",
    "cardTop": {
      "alpha": 0.35,
      "height": "max(32%, 64px)"
    },
    "cardBottom": {
      "leadAboveFirstText": 40,
      "tailBelowFirstText": 32,
      "alphaEnd": 0.6
    },
    "photoTextScrim": {
      "rule": "Beyar kararı: fotoğraf üstü metinde alttan scrim zorunlu",
      "status": "karar",
      "note": "değer (%60 tavan) docs/47 EK 3 açık konusu"
    },
    "heroLight": {
      "color": "primary",
      "alpha": 0.25,
      "origin": "topLeft",
      "end": 0.65,
      "blend": "screen"
    },
    "headerAlpha": "scrollY / min(48, firstTextTop - headerBottom - 8)"
  },
  "motion": {
    "ease": "cubic-bezier(.22,.61,.36,1)",
    "fast": 150,
    "quick": 180,
    "base": 200,
    "sheet": 250,
    "drawer": 250,
    "reveal": 450,
    "savePop": 450,
    "toast": 2800,
    "toastAction": 4000,
    "heroAutoplay": 6000,
    "skeleton": 1000,
