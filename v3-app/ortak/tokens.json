    "switch": 999,
    "_switchNote": "Beyar revize B4, 13 Ekim: anahtar iOS oranında (40×24, düğme 20, kenar boşluğu 2) ve tam yuvarlak; yalnız anahtar.",
    "_chipNote": "Beyar, 12 Ekim: köşe yüksekliğe oranla ana düğmeyle aynı sertlik (48/12 ≈ %25): 32–36px çip → 8, 20–24px rozet → 6. Yalnız küçük çip ve rozet; düğme/alan/kart/sekme/sheet değişmez.",
    "day": "50%",
    "dayBand": 999,
    "_dayNote": "Beyar, 13 Ekim (takvim yeniden): takvim gün hücresi daire (iOS / Material 3 tarih seçici), aralık bandı uçları yuvarlak hap; daire istisnası yalnız avatar, anahtar ve takvim günü."
  },
  "shadow": {
    "sm": "0 1px 2px rgba(33,30,22,.04), 0 2px 6px rgba(33,30,22,.05)",
    "md": "0 6px 22px rgba(33,30,22,.09)",
    "lg": "0 18px 50px rgba(33,30,22,.16)",
