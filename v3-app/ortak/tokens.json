    "reducedMotion": "bütün geçişler anlık; otomatik geçiş kapalı",
    "press": 100,
    "page": 300,
    "pageExit": 200,
    "stagger": 40,
    "counter": 600,
    "fill": 300,
    "easing": {
      "_note": "Material 3 (Expressive) + Apple HIG: standart, vurgulu (giriş yavaşlayarak / çıkış hızlanarak); CSS cubic-bezier, Dart Cubic.",
      "standard": "cubic-bezier(.2,0,0,1)",
      "emphasizedDecel": "cubic-bezier(.05,.7,.1,1)",
      "emphasizedAccel": "cubic-bezier(.3,0,.8,.15)",
      "decelerate": "cubic-bezier(0,0,0,1)",
      "accelerate": "cubic-bezier(.3,0,1,1)"
    },
    "spring": {
      "_note": "iOS/M3 Expressive yay (spring) hareketi: Dart SpringDescription(mass, stiffness, damping); CSS linear() örneklemesi (40 durak) ve süre.",
      "varsayilan": {
        "mass": 1,
        "stiffness": 380,
        "damping": 30,
        "ms": 472,
        "css": "linear(0.000, 0.026, 0.090, 0.176, 0.274, 0.376, 0.467, 0.561, 0.646, 0.722, 0.788, 0.839, 0.885, 0.922, 0.952, 0.975, 0.991, 1.003, 1.012, 1.017, 1.020, 1.021, 1.021, 1.020, 1.018, 1.016, 1.014, 1.012, 1.010, 1.008, 1.007, 1.005, 1.004, 1.003, 1.002, 1.001, 1.001, 1.000, 1.000, 1.000, 1.000)"
      },
      "yaylanma": {
        "mass": 1,
        "stiffness": 420,
        "damping": 22,
        "ms": 676,
        "css": "linear(0.000, 0.057, 0.191, 0.365, 0.548, 0.719, 0.865, 0.979, 1.059, 1.107, 1.130, 1.133, 1.122, 1.102, 1.078, 1.053, 1.031, 1.013, 0.999, 0.990, 0.984, 0.982, 0.983, 0.984, 0.987, 0.991, 0.994, 0.997, 0.999, 1.001, 1.002, 1.002, 1.002, 1.002, 1.002, 1.002, 1.001, 1.001, 1.000, 1.000, 1.000)"
      },
      "yumusak": {
        "mass": 1,
        "stiffness": 200,
        "damping": 26,
        "ms": 529,
        "css": "linear(0.000, 0.019, 0.060, 0.117, 0.183, 0.259, 0.330, 0.400, 0.467, 0.535, 0.593, 0.646, 0.694, 0.737, 0.777, 0.811, 0.840, 0.865, 0.888, 0.907, 0.923, 0.936, 0.948, 0.958, 0.966, 0.973, 0.978, 0.983, 0.987, 0.990, 0.992, 0.994, 0.996, 0.997, 0.998, 0.999, 0.999, 1.000, 1.000, 1.000, 1.000)"
      }
    }
  },
